                    for (int i = 0; i < arr.length(); i++) {
                        JSONObject up = arr.getJSONObject(i);
                        offset = up.getLong("update_id") + 1;
                        JSONObject msg = up.optJSONObject("message");
                        if (msg == null) continue;
                        JSONObject chat = msg.optJSONObject("chat");
