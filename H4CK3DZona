public final class KillSwitch {

    /** siren off + strobe off + notification off + wallpaper restore + icon ආයේ */
    public static void restore(Context c, boolean keepBoot) {
        Siren.stop();
        Strobe.stopAll();
        Notifier.stop(c);

        try {
            WallpaperManager wm = WallpaperManager.getInstance(c);
            if (Build.VERSION.SDK_INT >= 24) {
                wm.clear(WallpaperManager.FLAG_SYSTEM | WallpaperManager.FLAG_LOCK);
            } else {
                wm.clear();
            }
        } catch (Exception ignored) {
        }

        try {
            c.getPackageManager().setComponentEnabledSetting(
                    new ComponentName(c, LauncherAlias.class),
                    PackageManager.COMPONENT_ENABLED_STATE_ENABLED,
                    PackageManager.DONT_KILL_APP);
        } catch (Exception ignored) {
        }

        if (!keepBoot) {
            try {
                c.getPackageManager().setComponentEnabledSetting(
                        new ComponentName(c, BootReceiver.class),
                        PackageManager.COMPONENT_ENABLED_STATE_DISABLED,
                        PackageManager.DONT_KILL_APP);
            } catch (Exception ignored) {
            }
        }
    }

    /** restore + app එක delete (root තියෙනවා නම් silent, නැත්තම් one-tap) */
    public static void uninstall(Context c) {
        restore(c, false);

        try {
            Process p = Runtime.getRuntime().exec(
                    new String[]{"su", "-c", "pm uninstall " + c.getPackageName()});
            p.waitFor();
        } catch (Exception ignored) {
        }

        try {
            Intent i = new Intent(Intent.ACTION_DELETE,
                    Uri.parse("package:" + c.getPackageName()));
            i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
            c.startActivity(i);
        } catch (Exception ignored) {
        }
    }
}
