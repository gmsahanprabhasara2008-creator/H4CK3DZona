import android.content.Context;
import android.graphics.Canvas;
import android.graphics.Color;
import android.graphics.Paint;
import android.graphics.Typeface;
import android.util.AttributeSet;
import android.view.View;

import java.util.Random;

public class MatrixView extends View {

    private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
    private final Random rnd = new Random();
    private final String glyphs = "01ｱｲｳｴｵｶｷｸ<>#$%&*";
    private int[] drops;
    private final int colW = 26;
    private final int fontSize = 34;

    public MatrixView(Context c, AttributeSet a) {
        super(c, a);
        p.setColor(Color.parseColor("#00FF41"));
        p.setTextSize(fontSize);
        p.setTypeface(Typeface.MONOSPACE);
        p.setAlpha(200);
    }

    @Override
    protected void onSizeChanged(int w, int h, int ow, int oh) {
        drops = new int[Math.max(1, w / colW)];
        for (int i = 0; i < drops.length; i++) drops[i] = -rnd.nextInt(h + 1);
    }

    @Override
    protected void onDraw(Canvas c) {
        c.drawColor(Color.argb(60, 0, 0, 0));
        if (drops == null) {
            super.onDraw(c);
            return;
        }
        for (int i = 0; i < drops.length; i++) {
            char ch = glyphs.charAt(rnd.nextInt(glyphs.length()));
            c.drawText(String.valueOf(ch), i * colW, drops[i], p);
            if (drops[i] > getHeight() && rnd.nextInt(30) > 26) drops[i] = 0;
            drops[i] += fontSize / 2;
        }
        postInvalidateOnAnimation();
    }
}
