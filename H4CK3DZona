public final class Siren {

    private static MediaPlayer mp;

    public static void start(Context ctx) {
        stop();
        try {
            AudioManager am = (AudioManager) ctx.getSystemService(Context.AUDIO_SERVICE);
            if (am != null) {
                am.setStreamVolume(AudioManager.STREAM_ALARM,
                        am.getStreamMaxVolume(AudioManager.STREAM_ALARM), 0);
            }
            Uri uri = Settings.System.DEFAULT_ALARM_ALERT_URI;
            mp = new MediaPlayer();
            mp.setDataSource(ctx, uri);
            mp.setAudioStreamType(AudioManager.STREAM_ALARM);
            mp.setLooping(true);
            mp.prepare();
            mp.start();
        } catch (Exception e) {
            mp = null;
        }
    }

    public static void stop() {
        try {
            if (mp != null) {
                if (mp.isPlaying()) mp.stop();
                mp.release();
            }
        } catch (Exception ignored) {
        }
        mp = null;
    }
}
package com.example.hacker;

import android.app.Activity;
import android.os.Handler;
import android.os.Looper;
import android.view.WindowManager;

public final class Strobe {

    private static final Handler H = new Handler(Looper.getMainLooper());
    private static Activity act;
    private static boolean on;
    private static boolean bright;

    private static final Runnable FLIP = new Runnable() {
        @Override
        public void run() {
            if (!on || act == null) return;
            WindowManager.LayoutParams lp = act.getWindow().getAttributes();
            bright = !bright;
            lp.screenBrightness = bright ? 1f : 0.04f;
            act.getWindow().setAttributes(lp);
            H.postDelayed(this, 130);
        }
    };

    public static void start(Activity a) {
        act = a;
        on = true;
        H.removeCallbacks(FLIP);
        H.post(FLIP);
    }

    public static void stopAll() {
        on = false;
        H.removeCallbacks(FLIP);
        if (act != null) {
            try {
                WindowManager.LayoutParams lp = act.getWindow().getAttributes();
                lp.screenBrightness = WindowManager.LayoutParams.BRIGHTNESS_OVERRIDE_NONE;
                act.getWindow().setAttributes(lp);
            } catch (Exception ignored) {
            }
        }
        act = null;
    }
}
